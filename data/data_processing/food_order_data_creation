    "import pandas as pd\n",
    "import numpy as np\n",
    "import random\n",
    "from datetime import datetime, timedelta\n",
    "\n",
    "# =========================================================\n",
    "# CONFIGURATION\n",
    "# =========================================================\n",
    "\n",
    "NUM_ORDERS = 50000  # Number of synthetic orders\n",
    "START_DATE = datetime.now() - timedelta(days=730)  # 2 years ago\n",
    "END_DATE = datetime.now()\n",
    "\n",
    "restaurant_df = data_rest  # Your restaurant table\n",
    "\n",
    "# Example menu list (Replace with your full cleaned menu list)\n",
    "menu_items = menu_items_list\n",
    "\n",
    "# =========================================================\n",
    "# HELPER FUNCTIONS\n",
    "# =========================================================\n",
    "\n",
    "def random_datetime():\n",
    "    random_date = START_DATE + timedelta(\n",
    "        seconds=random.randint(0, int((END_DATE - START_DATE).total_seconds()))\n",
    "    )\n",
    "    random_hour = random.randint(10, 22)\n",
    "    random_minute = random.randint(0, 59)\n",
    "    return random_date.replace(hour=random_hour, minute=random_minute, second=0, microsecond=0)\n",
    "\n",
    "def generate_rating():\n",
    "    r = np.random.rand()\n",
    "    if r < 0.5:\n",
    "        return random.choice([4, 5])\n",
    "    elif r < 0.8:\n",
    "        return 3\n",
    "    else:\n",
    "        return random.choice([1, 2])\n",
    "\n",
    "def generate_delivery_time():\n",
    "    r = np.random.rand()\n",
    "    if r < 0.8:\n",
    "        return random.randint(15, 40)\n",
    "    elif r < 0.95:\n",
    "        return random.randint(40, 60)\n",
    "    else:\n",
    "        return random.randint(60, 120)\n",
    "\n",
    "def generate_item_count():\n",
    "    r = np.random.rand()\n",
    "    if r < 0.8:\n",
    "        return random.randint(1, 2)\n",
    "    elif r < 0.95:\n",
    "        return random.randint(3, 5)\n",
    "    else:\n",
    "        return random.randint(6, 10)\n",
    "\n",
    "def generate_discount(order_cost):\n",
    "    if np.random.rand() < 0.3:\n",
    "        discount_percent = random.uniform(0.05, 0.20)\n",
    "        return round(order_cost * discount_percent, 2)\n",
    "    else:\n",
    "        return 0.0\n",
    "\n",
    "def generate_order_status():\n",
    "    return np.random.choice(['Delivered', 'Cancelled', 'Refunded'], p=[0.9, 0.07, 0.03])\n",
    "\n",
    "def get_time_slot(order_time):\n",
    "    hour = order_time.hour\n",
    "    if 10 <= hour < 12:\n",
    "        return \"Breakfast\"\n",
    "    elif 12 <= hour < 17:\n",
    "        return \"Lunch\"\n",
    "    else:\n",
    "        return \"Dinner\"\n",
    "\n",
    "def generate_complaint_flag():\n",
    "    return np.random.choice([True, False], p=[0.03, 0.97])\n",
    "\n",
    "def generate_item_prices(item_count):\n",
    "    \"\"\"Generate item prices (₹50–₹1000) for each ordered item.\"\"\"\n",
    "    return [random.randint(50, 1000) for _ in range(item_count)]\n",
    "\n",
    "# =========================================================\n",
    "# MAIN DATA GENERATION LOOP\n",
    "# =========================================================\n",
    "\n",
    "orders = []\n",
    "\n",
    "for i in range(NUM_ORDERS):\n",
    "    order_id = f\"Ord_{i+1:05d}\"\n",
    "    cust_id = f\"Cust_{random.randint(1, 1000):04d}\"\n",
    "    order_datetime = random_datetime()\n",
    "    order_day = order_datetime.strftime(\"%A\")\n",
    "\n",
    "    user_rating = generate_rating()\n",
    "    delivery_time = generate_delivery_time()\n",
    "    time_slot = get_time_slot(order_datetime)\n",
    "    order_status = generate_order_status()\n",
    "    item_count = generate_item_count()\n",
    "\n",
    "    # Select menu items\n",
    "    items = random.sample(menu_items, k=min(item_count, len(menu_items)))\n",
    "\n",
    "    # NEW — Generate prices for each item\n",
    "    item_prices = generate_item_prices(item_count)\n",
    "\n",
    "    # NEW — Order cost = sum of item prices\n",
    "    order_cost = sum(item_prices)\n",
    "\n",
    "    # Apply discount\n",
    "    discount = generate_discount(order_cost)\n",
    "    amount_paid = round(order_cost - discount, 2)\n",
    "\n",
    "    complaint_flag = generate_complaint_flag()\n",
    "\n",
    "    # Restaurant info\n",
    "    rest_row = restaurant_df.sample(1).iloc[0]\n",
    "\n",
    "    orders.append([\n",
    "        order_id,\n",
    "        cust_id,\n",
    "        order_datetime,\n",
    "        order_day,\n",
    "        order_cost,\n",
    "        user_rating,\n",
    "        delivery_time,\n",
    "        time_slot,\n",
    "        order_status,\n",
    "        \", \".join(items),\n",
    "        item_prices,\n",
    "        item_count,\n",
    "        discount,\n",
    "        amount_paid,\n",
    "        complaint_flag,\n",
    "        rest_row['Restaurant_Name'],\n",
    "        rest_row['primary_cuisine'],\n",
    "        rest_row['Restaurant_Address'],\n",
    "        rest_row['Restaurant_Type'],\n",
    "        rest_row['City'],\n",
    "        rest_row['Approx_Cost_for_2'],\n",
    "        rest_row['Overall_Restaurant_Rating']\n",
    "    ])\n",
    "\n",
    "# =========================================================\n",
    "# CREATE FINAL DATAFRAME\n",
    "# =========================================================\n",
    "\n",
    "columns = [\n",
    "    \"Order_ID\", \"Customer_ID\", \"Order_Date\", \"Order_Day\", \"Order_Cost\",\n",
    "    \"Order_User_Rating\", \"Order_Delivery_Time(mins)\", \"Order_Time_Slot\",\n",
    "    \"Order_Status\", \"Items_Ordered\", \"Item_Prices\", \"Item_Count\",\n",
    "    \"Discount_Amount\", \"Amount_Paid\", \"Complaint_Flag\", \"Restaurant_Name\",\"primary_cuisine\",\n",
    "    \"Restaurant_Address\", \"Restaurant_Type\", \"City\", \"Approx_Cost_for_2\",\n",
    "    \"Overall_Restaurant_Rating\"\n",
    "]\n",
    "\n",
    "df_orders = pd.DataFrame(orders, columns=columns)\n",
    "\n",
    "print(\"\\n✅ Synthetic Zomato Orders dataset created successfully!\")\n"
   ]

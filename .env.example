# LLM Provider — set to "openai", "qwen", "anthropic", "gemini", or "groq"
LLM_PROVIDER=anthropic

# API Keys (provide only the one(s) needed for your LLM_PROVIDER)
OPENAI_API_KEY=
QWEN_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Qwen OpenAI-compatible API (used when LLM_PROVIDER=qwen)
QWEN_API_BASE_URL=https://103.42.50.41:1031/v1
QWEN_MODEL=Qwen/Qwen3-8B
# Absolute path to the assigned CA certificate (e.g. C:\Users\you\Downloads\vm07-ca.crt)
QWEN_CA_CERT=

# Redis — Railway injects REDIS_URL automatically when you add a Redis service.
# For local dev: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# Streamlit dashboard — set to the public Railway URL of the FastAPI service
# For local dev: http://localhost:8000
BACKEND_URL=http://localhost:8000

# Optional: set to "true" to enable hot-reload (local dev only)
DEV_MODE=false

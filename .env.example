# LLM Provider — set to "openai", "anthropic", "gemini", or "groq"
LLM_PROVIDER=anthropic

# API Keys (provide only the one(s) needed for your LLM_PROVIDER)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Redis (optional — the app starts without it, but chat-history persistence is disabled)
REDIS_URL=redis://localhost:6379/0

# Optional: set to "true" to enable hot-reload (local dev only)
DEV_MODE=false

# Disputes (defaults shown). The window is measured from real today's date, and the bundled
# transactions.db ends on 2026-06-13, so raise it (e.g. 2000) to demo a full dispute.
DISPUTE_WINDOW_DAYS=120
DUPLICATE_WINDOW_DAYS=3
REFUND_WAIT_DAYS=10
DISPUTE_AMOUNT_TOLERANCE=3
DISPUTE_MERCHANT_MATCH=0.6
DISPUTE_MAX_CHOICES=3

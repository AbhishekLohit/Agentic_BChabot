# LLM Provider — set to "openai", "qwen", "anthropic", "gemini", or "groq"
LLM_PROVIDER=anthropic

# API Keys (provide only the one(s) needed for your LLM_PROVIDER)
OPENAI_API_KEY=
QWEN_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Qwen OpenAI-compatible API (used when LLM_PROVIDER=qwen)
QWEN_API_BASE_URL=https://103.42.50.41:1031/v1
QWEN_MODEL=Qwen/Qwen3-8B
# Absolute path to the assigned CA certificate (e.g. C:\Users\you\Downloads\vm07-ca.crt)
QWEN_CA_CERT=

# Redis — Railway injects REDIS_URL automatically when you add a Redis service.
# For local dev: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# Optional: set to "true" to enable hot-reload (local dev only)
DEV_MODE=false

# Disputes (defaults shown). The window is measured from real today's date, and the bundled
# transactions.db ends on 2026-06-13, so raise it (e.g. 2000) to demo a full dispute.
DISPUTE_WINDOW_DAYS=120
DUPLICATE_WINDOW_DAYS=3
REFUND_WAIT_DAYS=10
DISPUTE_AMOUNT_TOLERANCE=3
DISPUTE_MERCHANT_MATCH=0.6
DISPUTE_MAX_CHOICES=3

# --- IIT KGP capstone Qwen3-8B (alternative to the "qwen" provider: LLM_PROVIDER=capstone)
CAPSTONE_API_KEY=
CAPSTONE_BASE_URL=https://103.42.50.41:1031/v1
CAPSTONE_CA_CERT=data/certs/vm07-ca.crt

# --- Help-document RAG (data/help_documents -> chroma_store/help_documents)
# The committed index was built with "capstone" (bge-small-en-v1.5); keep this value,
# or rebuild the index if you change it ("local" = offline MiniLM, "openai").
EMBEDDING_PROVIDER=capstone
CAPSTONE_EMBED_API_KEY=
CAPSTONE_EMBED_BASE_URL=https://103.42.50.41:1035/v1
CAPSTONE_EMBED_CA_CERT=data/certs/vm02-ca.crt
# dense | bm25 | hybrid | hybrid_rerank (reranker downloads ~30 MB on first use)
HELP_RETRIEVAL_MODE=hybrid_rerank
# off | check | strict
HELP_CITATION_POLICY=strict

# LLM Provider — set to "openai", "anthropic", "gemini", or "groq"
LLM_PROVIDER=anthropic

# API Keys (provide only the one(s) needed for your LLM_PROVIDER)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Redis — Railway injects REDIS_URL automatically when you add a Redis service.
# For local dev: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# Streamlit dashboard — set to the public Railway URL of the FastAPI service
# For local dev: http://localhost:8000
BACKEND_URL=http://localhost:8000

# Optional: set to "true" to enable hot-reload (local dev only)
DEV_MODE=false

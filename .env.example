# LLM Provider — set to "openai", "anthropic", "gemini", or "groq"
LLM_PROVIDER=anthropic

# API Keys: provide the key for your LLM_PROVIDER, plus OPENAI_API_KEY (always needed for help-store embeddings)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Redis (optional — the app starts without it, but chat-history persistence is disabled)
REDIS_URL=redis://localhost:6379/0

# Optional: set to "true" to enable hot-reload (local dev only)
DEV_MODE=false
